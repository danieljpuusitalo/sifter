{
  "name": "sifter",
  "description": "Hides the ads your ad blocker misses.",
  "private": true,
  "version": "1.3.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && wxt zip",
    "zip": "wxt zip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && playwright test",
    "eval:mock": "tsx evals/run.ts --provider mock",
    "verify": "pnpm typecheck && pnpm test && pnpm eval:mock",
    "postinstall": "wxt prepare",
    "bench:scroll": "wxt build && tsx bench/scroll.ts",
    "bench:live": "tsx bench/live.ts",
    "icons": "node scripts/render-icons.mjs",
    "store:assets": "wxt build && node scripts/store-assets.mjs",
    "pages": "node scripts/build-pages.mjs",
    "readme:gif": "wxt build && node scripts/readme-gif.mjs",
    "release": "node scripts/release.mjs",
    "check:permissions": "node scripts/check-permissions.mjs",
    "canary": "tsx bench/canary.ts"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "marked": "^18.2.0",
    "preact": "^11.2.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5",
    "zod": "^4.6.7"
  }
}
